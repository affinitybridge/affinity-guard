<?xml version="1.0"?>
<ruleset name="Affinity Guard">
	<description>WordPress coding standards for Affinity Guard.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- The plugin is namespaced, so file-level prefixes are not required. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>

		<!--
		Filter callbacks take the signature WordPress hands them. Every callback
		here answers from configuration and deliberately ignores the incoming
		value, so the unused arguments are the point rather than an oversight.
		-->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<config name="minimum_wp_version" value="5.2"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
