<?xml version="1.0"?>
<ruleset name="Affinity Guard">
	<description>WordPress coding standards for Affinity Guard.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- The plugin is namespaced, so file-level prefixes are not required. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>

		<!--
		Filter callbacks take the signature WordPress hands them. Every callback
		here answers from configuration and deliberately ignores the incoming
		value, so the unused arguments are the point rather than an oversight.
		-->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<!--
	tools/ holds command line diagnostics, run through WP-CLI and printed to a
	terminal. Escaping their output would put HTML entities on the operator's
	screen, and WP_Filesystem is the wrong instrument for reporting whether a
	path is writable, which is the very thing being diagnosed.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="5.2"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
